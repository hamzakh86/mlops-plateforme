# Variables d'environnement pour le script d'entraînement
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement.
# IMPORTANT : Ne jamais committer le fichier .env dans Git !

MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=Iris_Classification
TEST_SIZE=0.2
RANDOM_STATE=42

# ─── RAG ────────────────────────────────────────────────────────────────────────
RAG_EXPERIMENT_NAME=RAG_Document_QA
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── LLM (Groq — API cloud gratuite) ────────────────────────────────────────────
# Récupérez votre clé sur : https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Environnements virtuels
.env
.venv
env/
venv/
ENV/

# VS Code / IDEs
.vscode/
.idea/

# MLflow
mlruns/
*.db

# Données générées (RAG) — l'index FAISS est un artefact reconstructible, pas du code source
data/processed/

# Tests & couverture
.pytest_cache/
.pytest_temp/
.coverage
htmlcov/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# Frontend React
frontend/node_modules/
frontend/dist/

# OS
.DS_Store
Thumbs.db

# Secrets Kubernetes (si tu ajoutes des Secret manifests avec des valeurs en clair)
k8s/*secret*.yaml
k8s/*.local.yaml
